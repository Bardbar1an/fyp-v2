#VRML_SIM R2025a utf8
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/humans/pedestrian/protos/Pedestrian.proto"
WorldInfo {
  basicTimeStep 32
  coordinateSystem "ENU"
  contactProperties [
    ContactProperties { material1 "caster" material2 "floor" coulombFriction [ 0.01 ] }
    ContactProperties { material1 "wheel" material2 "floor" coulombFriction [ 1.0 ] }
  ]
}
DEF VIEW Viewpoint { orientation -0.2466225412152089 0.595399483788675 0.764641600273443 0.9929116247422933 position -4.75 -5.5 6.2 fieldOfView 0.95 }
Background { skyColor [ 0.12 0.18 0.23 ] }
DirectionalLight { direction -0.4 0.2 -1 intensity 1 }
Solid {
  translation 0 0 -0.05
  children [ Shape { appearance PBRAppearance { baseColor 0.3 0.36 0.4 roughness 1 metalness 0 } geometry Box { size 60 60 0.1 } } ]
  name "floor"
  contactMaterial "floor"
  boundingObject Box { size 60 60 0.1 }
}
DEF HUMAN Pedestrian {
  translation 1.5 0 1.27
  name "Target human"
  controller "walking_human"
  controllerArgs [ "stop_go" ]
  shirtColor 1 0.6 0.2
  enableBoundingObject TRUE
}
DEF FOLLOWER Robot {
  translation 0 0 0.13
  children [
    Shape { appearance PBRAppearance { baseColor 0.08 0.75 0.58 roughness 0.6 metalness 0.1 } geometry Box { size 0.42 0.30 0.12 } }
    Pose { translation 0.18 0 0.09 children [ Shape { appearance PBRAppearance { baseColor 0.1 0.15 0.18 } geometry Box { size 0.07 0.16 0.07 } } ] }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0 0.18 -0.05 }
      device [ RotationalMotor { name "left wheel motor" maxVelocity 14 maxTorque 5 } ]
      endPoint Solid {
        translation 0 0.18 -0.05
        rotation 1 0 0 1.57079632679
        children [ Shape { appearance DEF TIRE PBRAppearance { baseColor 0.035 0.045 0.055 roughness 1 metalness 0 } geometry Cylinder { radius 0.08 height 0.04 } } ]
        name "left wheel"
        contactMaterial "wheel"
        boundingObject Cylinder { radius 0.08 height 0.04 }
        physics Physics { density -1 mass 0.2 }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0 -0.18 -0.05 }
      device [ RotationalMotor { name "right wheel motor" maxVelocity 14 maxTorque 5 } ]
      endPoint Solid {
        translation 0 -0.18 -0.05
        rotation 1 0 0 1.57079632679
        children [ Shape { appearance USE TIRE geometry Cylinder { radius 0.08 height 0.04 } } ]
        name "right wheel"
        contactMaterial "wheel"
        boundingObject Cylinder { radius 0.08 height 0.04 }
        physics Physics { density -1 mass 0.2 }
      }
    }
    Solid {
      translation -0.16 0 -0.1
      children [ Shape { appearance USE TIRE geometry Sphere { radius 0.03 } } ]
      name "rear skid caster"
      contactMaterial "caster"
      boundingObject Sphere { radius 0.03 }
      physics Physics { density -1 mass 0.05 }
    }
    Solid {
      translation 0.16 0 -0.1
      children [ Shape { appearance USE TIRE geometry Sphere { radius 0.03 } } ]
      name "front skid caster"
      contactMaterial "caster"
      boundingObject Sphere { radius 0.03 }
      physics Physics { density -1 mass 0.05 }
    }
  ]
  name "Differential drive follower"
  controller "human_follower"
  controllerArgs [ "fuzzy" "stop_go" "48" ]
  supervisor TRUE
  boundingObject Box { size 0.42 0.30 0.12 }
  physics Physics { density -1 mass 4 }
}

